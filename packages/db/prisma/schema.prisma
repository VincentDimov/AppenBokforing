model YearCarryForward {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  sourceFiscalYearId String @map("source_fiscal_year_id") @db.Uuid
  targetFiscalYearId String @map("target_fiscal_year_id") @db.Uuid
  resultAccountId String @map("result_account_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  fingerprint String @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceFiscalYear FiscalYear @relation("CarryForwardSource", fields: [sourceFiscalYearId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  targetFiscalYear FiscalYear @relation("CarryForwardTarget", fields: [targetFiscalYearId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  resultAccount Account @relation(fields: [resultAccountId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([organizationId, targetFiscalYearId])
  @@map("year_carry_forwards")
}

model AuditEvent {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  actorUserId    String?         @map("actor_user_id") @db.Uuid
  action         AuditAction
  entityType     AuditEntityType @map("entity_type")
  entityId       String?         @map("entity_id") @db.Uuid
  beforeData     Json?           @map("before_data")
  afterData      Json?           @map("after_data")
  metadata       Json?
  ipAddress      String?         @map("ip_address") @db.VarChar(64)
  requestId      String?         @map("request_id") @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor        User?        @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([requestId])
  @@map("audit_events")
}

model SieExport {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  fiscalYearId       String       @map("fiscal_year_id") @db.Uuid
  outputAttachmentId String?      @map("output_attachment_id") @db.Uuid
  status             SieJobStatus @default(PENDING)
  exportedById       String?      @map("exported_by_id") @db.Uuid
  startedAt          DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?    @map("completed_at") @db.Timestamptz(3)
  exportedEntryCount Int          @default(0) @map("exported_entry_count")
  errorDetails       Json?        @map("error_details")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fiscalYear       FiscalYear   @relation(fields: [fiscalYearId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  outputAttachment Attachment?  @relation("SieExportOutputAttachment", fields: [outputAttachmentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  exportedBy       User?        @relation("SieExportInitiatedBy", fields: [exportedById], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([organizationId, outputAttachmentId])
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@map("sie_exports")
}
