# test@test.com
# Ledgerapp123456

# Application runtime
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# Next.js proxies browser requests to the API. In containers this can instead be http://api:4000.
API_INTERNAL_URL=http://localhost:4000

# PostgreSQL (used by Docker Compose and Prisma)
POSTGRES_DB=ledgerapp
POSTGRES_USER=ledgerapp
POSTGRES_PASSWORD=ledgerapp_local_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://ledgerapp:ledgerapp_local_password@localhost:5433/ledgerapp?schema=public

# Local S3-compatible object storage
MINIO_ROOT_USER=ledgerapp_minio
MINIO_ROOT_PASSWORD=ledgerapp_minio_local_password
S3_ENDPOINT=http://localhost:9000
# Use this only when the API reaches S3 internally through a hostname that a browser cannot resolve.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=eu-north-1
S3_BUCKET=ledgerapp-local
S3_ACCESS_KEY_ID=ledgerapp_minio
S3_SECRET_ACCESS_KEY=ledgerapp_minio_local_password
S3_SIGNED_URL_TTL_SECONDS=300

# Authentication. Replace every secret before any non-local deployment.
JWT_ACCESS_SECRET=local-development-access-secret-change-before-production
JWT_REFRESH_SECRET=local-development-refresh-secret-change-before-production
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_ABSOLUTE_TTL_SECONDS=2592000
JWT_ISSUER=ledgerapp-api
JWT_AUDIENCE=ledgerapp-web
# Production must retain at least 65536 KiB and 3 iterations.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
